# Plantilla de configuración de VetCare (factor III).
# Copie este archivo como .env y ponga los valores de su máquina. El .env no se sube (.gitignore).
# Aquí solo van nombres y valores de ejemplo inofensivos: nunca un valor real.

# Puerto por el que la API expone HTTP (factores III y VII). No es secreto.
PORT=3000

# Conexión a la base de datos MySQL: usuario, contraseña, servidor y base (factores III y IV). ES SECRETO.
DATABASE_URL=mysql://usuario:cambia-esto@localhost:3306/vetcare

# Horario de atención de la clínica, en horas enteras de 0 a 24; el cierre no se incluye. No es secreto.
HORA_APERTURA=8
HORA_CIERRE=18